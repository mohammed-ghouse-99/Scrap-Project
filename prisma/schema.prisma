// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
model ScrapRate {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String
  price     Float
  unit      String   @default("kg")
  image     String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Pickup {
  id         String    @id @default(cuid())
  name       String
  phone      String    @default("") // Customer contact number
  type       String    // Scrap type
  location   String    // Area in Hyderabad
  weight     String    // Approx weight
  status     String    @default("PENDING") // PENDING, COMPLETED, CANCELLED
  rating     Int?      // 1-5 star review rating
  feedback   String?   // Optional customer text feedback
  feedbackAt DateTime? // Feedback timestamp
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}